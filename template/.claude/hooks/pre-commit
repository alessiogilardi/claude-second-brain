#!/bin/sh
#
# [SECOND BRAIN SYSTEM] pre-commit hook
#
# Blocca il commit se ci sono modifiche staged al di fuori di docs/ e CLAUDE.md
# senza che la documentazione (docs/ o CLAUDE.md) sia stata aggiornata di
# conseguenza. Forza il team (o Claude Code) a mantenere il "second brain"
# allineato al codice ad ogni commit.

staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
    exit 0
fi

docs_changed=$(printf '%s\n' "$staged_files" | grep -E '^docs/|^CLAUDE\.md$')
source_changed=$(printf '%s\n' "$staged_files" | grep -vE '^docs/|^CLAUDE\.md$')

if [ -n "$source_changed" ] && [ -z "$docs_changed" ]; then
    echo ""
    echo "=================================================================="
    echo "  [SECOND BRAIN SYSTEM] COMMIT REJECTED"
    echo "=================================================================="
    echo ""
    echo "  Hai staged modifiche al codice sorgente, ma nessuna modifica in"
    echo "  docs/ o nel file CLAUDE.md."
    echo ""
    echo "  Claude, prima di ripetere il commit esegui la skill:"
    echo "    .claude/skills/update-second-brain"
    echo ""
    echo "  per allineare ADR, schema database, pattern e strategie di"
    echo "  testing alle modifiche appena introdotte, poi ristadia i file"
    echo "  di documentazione aggiornati e riprova il commit."
    echo ""
    echo "=================================================================="
    exit 1
fi

exit 0
