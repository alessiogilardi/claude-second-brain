#!/bin/sh
#
# [SECOND BRAIN SYSTEM] pre-commit hook
#
# Blocks the commit if there are staged changes outside docs/ and CLAUDE.md
# without the documentation (docs/ or CLAUDE.md) having been updated
# accordingly. Forces the team (or Claude Code) to keep the "second brain"
# aligned with the code on every commit.

staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
    exit 0
fi

docs_changed=$(printf '%s\n' "$staged_files" | grep -E '^docs/|^CLAUDE\.md$')
source_changed=$(printf '%s\n' "$staged_files" | grep -vE '^docs/|^CLAUDE\.md$')

if [ -n "$source_changed" ] && [ -z "$docs_changed" ]; then
    echo ""
    echo "=================================================================="
    echo "  [SECOND BRAIN SYSTEM] COMMIT REJECTED"
    echo "=================================================================="
    echo ""
    echo "  You have staged source code changes, but no change in docs/"
    echo "  or in the CLAUDE.md file."
    echo ""
    echo "  Claude, before retrying the commit run the skill:"
    echo "    .claude/skills/update-second-brain"
    echo ""
    echo "  to align ADRs, database schema, patterns, and testing"
    echo "  strategies with the changes you just introduced, then stage"
    echo "  the updated documentation files and retry the commit."
    echo ""
    echo "=================================================================="
    exit 1
fi

exit 0
